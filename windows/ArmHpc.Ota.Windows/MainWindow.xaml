<Window x:Class="ArmHpc.Ota.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ARMHPC OTA 1.2.0 · 批量管理与命令" Width="1380" Height="990" MinWidth="1120" MinHeight="860"
 Background="#F3F6FA" FontFamily="Microsoft YaHei UI, Segoe UI" Closing="WindowClosing">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
  <Border Background="#15314D" Padding="20,8">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="ARMHPC OTA" FontSize="25" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="发现设备 → 管理或升级 → 查看各设备结果" Foreground="#BED2E5" FontSize="12" Margin="0,2,0,0"/></StackPanel>
    <TextBlock Grid.Column="1" Text="1.2.0   ·   SSH / USB 串口   ·   并发 1–8" Foreground="#BED2E5" VerticalAlignment="Center"/>
   </Grid>
  </Border>
  <Grid Grid.Row="1" Margin="16,10">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*" MinHeight="175"/><RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="1.35*" MinHeight="145"/></Grid.RowDefinitions>
   <Border Background="White" CornerRadius="7" Padding="12,8" Margin="0,0,0,8">
    <Expander Header="发现与登录" IsExpanded="True" Foreground="#15314D">
     <StackPanel Margin="0,8,0,0">
      <WrapPanel>
       <TextBlock Text="扫描范围" VerticalAlignment="Center" Margin="0,0,8,6"/>
       <TextBox x:Name="ScanRange" Width="175" Margin="0,0,8,6" ToolTip="明确允许扫描和重连的 IPv4 网段。"/>
       <Button Content="扫描 SSH / 主机名" Click="ScanClick" ToolTip="仅发现 SSH 并查询 DNS/mDNS 名称；扫描不登录设备。"/>
       <Button Content="停止扫描" Click="StopScanClick"/>
       <TextBox x:Name="ManualAddress" Width="135" Margin="6,0,8,6" ToolTip="设备当前 IPv4 地址"/>
       <Button Content="添加地址" Click="AddClick"/><Button Content="导入 CSV" Click="ImportClick"/><Button Content="导出 CSV" Click="ExportClick"/>
       <Button Content="添加串口" Click="PortsClick"/><Button Content="释放串口" Click="DisconnectClick"/>
      </WrapPanel>
      <WrapPanel>
       <Button Content="默认登录设置" Click="DefaultCredentialsClick"/><Button Content="清除默认登录" Click="ClearDefaultCredentialsClick"/>
       <Button Content="认证所选设备" Click="ConnectClick"/><Button Content="按默认重新认证" Click="DefaultConnectClick"/>
       <Button x:Name="CancelAuthenticationButton" Content="取消认证" Click="CancelAuthenticationClick" IsEnabled="False"/>
       <Button Content="单台登录设置" Click="DeviceCredentialsClick"/><Button Content="SSH 身份（单台）" Click="PinsClick"/>
       <TextBlock x:Name="DefaultCredentialsStatus" Text="默认登录：未设置" Foreground="#62758A" VerticalAlignment="Center" Margin="8,0,0,6"/>
      </WrapPanel>
     </StackPanel>
    </Expander>
   </Border>
   <Border Grid.Row="1" Background="White" CornerRadius="7" Padding="12,8" Margin="0,0,0,8">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <WrapPanel>
      <TextBlock Text="主机筛选" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBox x:Name="HostFilter" Width="225" TextChanged="FilterChanged" Margin="0,0,12,0" ToolTip="主机名、MAC 地址、IP 地址或设备 ID；精确模式只匹配主机名。"/>
      <CheckBox x:Name="ExactHostname" Content="精确匹配" Checked="FilterChanged" Unchecked="FilterChanged" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <ComboBox x:Name="ModeFilter" Width="105" SelectedIndex="0" SelectionChanged="FilterChanged"><ComboBoxItem Content="全部环境" Tag="all"/><ComboBoxItem Content="普通系统" Tag="system"/><ComboBoxItem Content="Rescue" Tag="rescue"/></ComboBox>
     </WrapPanel>
     <StackPanel Grid.Column="1">
      <WrapPanel HorizontalAlignment="Right"><Button Content="全选可见设备" Click="SelectVisibleClick"/><Button Content="反选" Click="InvertVisibleClick"/><Button Content="清空选择" Click="ClearSelectionClick"/><Button x:Name="RemoveDevicesButton" Content="删除所选主机" Click="RemoveDevicesClick" Foreground="#963B36" Margin="0,0,0,3"/></WrapPanel>
      <TextBlock x:Name="SelectionSummary" Foreground="#62758A" FontSize="11" HorizontalAlignment="Right"/>
     </StackPanel>
    </Grid>
   </Border>
   <DataGrid x:Name="DeviceGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
    SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column" FrozenColumnCount="2"
    ScrollViewer.HorizontalScrollBarVisibility="Visible" ScrollViewer.VerticalScrollBarVisibility="Auto"
    RowDetailsVisibilityMode="Collapsed" Background="White" BorderBrush="#D8E1EC" RowHeight="32"
    SelectionChanged="SelectionChanged" RowEditEnding="DeviceEdited" PreviewKeyDown="DeviceGridKeyDown"
    GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E8EDF4" AlternatingRowBackground="#F7F9FC">
    <DataGrid.Columns>
     <DataGridCheckBoxColumn Header="选中" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
     <DataGridTextColumn Header="主机名" Binding="{Binding Hostname}" Width="180" IsReadOnly="True"/>
     <DataGridTextColumn Header="MAC 地址" Binding="{Binding MacAddress}" Width="155" IsReadOnly="True"/>
     <DataGridTextColumn Header="地址 / COM" Binding="{Binding Address}" Width="140" IsReadOnly="True"/>
     <DataGridTextColumn Header="板卡" Binding="{Binding Board}" Width="130" IsReadOnly="True"/>
     <DataGridTextColumn Header="环境" Binding="{Binding Mode}" Width="72" IsReadOnly="True"/>
     <DataGridTextColumn Header="普通系统版本" Binding="{Binding SystemVersion}" Width="180" IsReadOnly="True"/>
     <DataGridTextColumn Header="Rescue 版本 / 槽" Binding="{Binding RescueVersion}" Width="195" IsReadOnly="True"/>
     <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="165" IsReadOnly="True"/>
     <DataGridTextColumn Header="最近命令" Binding="{Binding LastCommand}" Width="160" IsReadOnly="True"/>
     <DataGridTextColumn Header="返回概况" Binding="{Binding CommandSummary}" Width="240" IsReadOnly="True"/>
    </DataGrid.Columns>
   </DataGrid>
   <Border Grid.Row="3" Background="White" CornerRadius="7" Padding="12,9" Margin="0,8,0,6"><StackPanel>
    <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <WrapPanel><TextBlock Text="并发" VerticalAlignment="Center" Margin="0,0,8,6"/><ComboBox x:Name="Concurrency" Width="65" SelectedIndex="0" Margin="0,0,14,6"><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/><ComboBoxItem Content="6"/><ComboBoxItem Content="7"/><ComboBoxItem Content="8"/></ComboBox>
      <TextBlock Text="OTA 目标" VerticalAlignment="Center" Margin="0,0,8,6"/><ComboBox x:Name="Target" Width="95" SelectedIndex="0" Margin="0,0,14,6"><ComboBoxItem Content="all"/><ComboBoxItem Content="system"/><ComboBoxItem Content="rescue"/></ComboBox>
      <TextBlock Text="版本 / 基线" VerticalAlignment="Center" Margin="0,0,8,6"/><TextBox x:Name="Release" Width="245" ToolTip="推送可留空读取包内版本；恢复填写 initial、current 或完整版本。" Margin="0,0,12,6"/>
     </WrapPanel>
     <WrapPanel Grid.Column="1"><Button Content="刷新状态 / 主机名 / MAC" Tag="status" Click="CommandClick"/><Button Content="停止后续设备" Click="StopBatchClick" Background="#FFF1EF" Foreground="#963B36" BorderBrush="#ECC6C2" Margin="0,0,0,6"/></WrapPanel>
    </Grid>
    <TabControl x:Name="OperationsTabs" Background="White" BorderBrush="#D8E1EC" Padding="9" MinHeight="138">
     <TabItem Header="设备管理"><StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ComboBox x:Name="CommandPreset" Width="255" DisplayMemberPath="Name" SelectionChanged="CommandPresetChanged" Margin="0,0,10,6"/>
       <TextBox x:Name="CommandLine" Grid.Column="1" Text="armhpc --help" FontFamily="Consolas" Margin="0,0,10,6" ToolTip="ARMHPC 命令和字面参数；不接受拼接 shell。"/>
       <Button Grid.Column="2" Content="并发发送到所选设备" Click="SendCommandClick" Style="{StaticResource PrimaryButton}" Margin="0,0,0,6"/>
      </Grid>
      <WrapPanel><CheckBox x:Name="IgnoreUnknownCommand" Content="提交结果未知时继续后续设备" Margin="0,5,20,7" ToolTip="保留 unknown 状态，不自动重发。"/><CheckBox x:Name="CommandPilot" Content="先执行一台试点" Margin="0,5,20,7"/><Button Content="交互 SSH 终端（单台）" Click="TerminalClick" Margin="0,0,0,6"/></WrapPanel>
      <TextBlock Text="重启类命令等待同一设备的新 boot ID；主机名与 MAC 可通过刷新状态更新。" Foreground="#62758A" TextWrapping="Wrap"/>
     </StackPanel></TabItem>
     <TabItem Header="批量 OTA"><StackPanel>
      <CheckBox x:Name="OtaPilot" Content="先完成一台升级试点，再并发后续设备" IsChecked="True" Margin="0,0,0,8"/>
      <WrapPanel><Button Content="推送并升级所选设备" Click="AutomaticClick" Style="{StaticResource PrimaryButton}"/><Button Content="更新所选 OTA 工具" Click="AutomaticToolsClick"/><Button Content="继续所选已批准任务" Click="ResumeTasksClick"/></WrapPanel>
      <WrapPanel><Button Content="任务状态" Tag="status" Click="CommandClick"/><Button Content="任务日志" Tag="logs" Click="CommandClick"/><Button Content="设备诊断" Tag="doctor" Click="CommandClick"/><Button Content="写盘前取消" Tag="cancel" Click="CommandClick"/><Button Content="写盘前重试" Tag="retry" Click="CommandClick"/><Button Content="Rescue 恢复" Tag="recover" Click="CommandClick"/><Button Content="工具维护状态" Click="ToolsStatusClick"/><Button Content="回退工具维护" Click="ToolsRollbackClick"/></WrapPanel>
      <TextBlock Text="失败暂停后续队列；停止批量后，已提交的设备任务继续执行。" Foreground="#62758A" TextWrapping="Wrap"/>
     </StackPanel></TabItem>
     <TabItem Header="首次接入"><StackPanel>
      <CheckBox x:Name="BootstrapPilot" Content="接入先完成一台试点，再并发后续设备" IsChecked="True" Margin="0,0,0,8"/>
      <WrapPanel><Button Content="接入预览" Tag="bootstrap" Click="CommandClick"/><Button Content="批量接入（按并发）" Click="BootstrapClick"/></WrapPanel>
      <TextBlock Text="已有完整 OTA 布局的设备可直接使用批量 OTA；接入前先查看设备返回的分区计划。" Foreground="#62758A" TextWrapping="Wrap"/>
     </StackPanel></TabItem>
     <TabItem Header="开发与诊断" x:Name="DevelopmentTab"><ScrollViewer MaxHeight="290" VerticalScrollBarVisibility="Auto"><StackPanel>
      <WrapPanel><ComboBox x:Name="DevelopmentPreset" Width="255" DisplayMemberPath="Name" SelectionChanged="DevelopmentPresetChanged" Margin="0,0,10,6"/><Button Content="执行所选开发命令" Click="SendDevelopmentCommandClick"/></WrapPanel>
      <Expander Header="看门狗与 BOOT 诊断" Margin="0,2,0,6"><StackPanel Margin="0,7,0,0">
       <WrapPanel><Button Content="看门狗状态" Tag="status" Click="WatchdogQueryClick"/><Button Content="诊断报告" Tag="report" Click="WatchdogQueryClick"/><Button Content="准备诊断" Click="WatchdogPrepareClick"/><Button Content="执行复位诊断" Click="WatchdogTestClick"/><Button Content="允许的 COM 接管" Click="DiagnosticComClick"/></WrapPanel>
       <WrapPanel><Button Content="BOOT 维护状态" Click="BootStatusClick"/><Button Content="候选 / 备份 / 恢复导出" Click="BootCandidateClick"/><Button Content="确认 BOOT / 更新配套系统" Click="BootCommitClick"/><Button Content="BOOT 回滚" Click="BootRollbackClick"/><Button Content="OESP USB 恢复" Click="UsbRescueClick"/><Button Content="恢复 BOOT" Click="BootRestoreClick"/></WrapPanel>
       <TextBlock Text="看门狗故障与 BOOT 操作限定单台、并发 1，按原诊断 ID 查询结果。" Foreground="#62758A" TextWrapping="Wrap"/>
      </StackPanel></Expander>
      <Expander Header="更新源与发布工具" Margin="0,2,0,6"><StackPanel Margin="0,7,0,0">
       <WrapPanel><Button Content="拉取计划" Tag="plan" Click="CommandClick"/><Button Content="设备下载" Tag="download" Click="CommandClick"/><Button Content="更新源（单台）" Click="SourceClick"/><Button Content="内网发布" Click="PublishClick"/><Button x:Name="StartBatchButton" Content="兼容：从源拉取升级" Click="BatchClick"/><Button Content="OTA 工具维护" Click="ToolsClick"/></WrapPanel>
      </StackPanel></Expander>
      <Expander Header="连接与时间诊断" Margin="0,2,0,2"><StackPanel Margin="0,7,0,0">
       <CheckBox x:Name="IgnoreSshFingerprint" Content="临时忽略 SSH 指纹" Checked="IgnoreFingerprintChanged" Unchecked="IgnoreFingerprintChanged" Margin="0,0,0,8"/>
       <TextBlock Text="当前所选设备的时间记录" FontWeight="SemiBold" Margin="0,0,0,4"/>
       <TextBlock Text="{Binding ElementName=DeviceGrid, Path=SelectedItem.ClockDetail}" TextWrapping="Wrap" Foreground="#62758A"/>
      </StackPanel></Expander>
     </StackPanel></ScrollViewer></TabItem>
    </TabControl>
   </StackPanel></Border>
   <GridSplitter Grid.Row="4" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="#D9E3ED"/>
   <Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="350"/><ColumnDefinition Width="6"/><ColumnDefinition Width="2*" MinWidth="260"/></Grid.ColumnDefinitions>
    <Border Background="White" CornerRadius="7" Padding="12"><DockPanel><TextBlock DockPanel.Dock="Top" Text="设备结果（事件时间来自设备）" FontWeight="SemiBold" Foreground="#15314D" Margin="0,0,0,8"/><TextBox x:Name="ResultText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI" BorderThickness="0"/></DockPanel></Border>
    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#D9E3ED"/>
    <Border Grid.Column="2" Background="White" CornerRadius="7" Padding="12"><DockPanel><TextBlock DockPanel.Dock="Top" Text="队列 / 重连日志（电脑接收时间）" FontWeight="SemiBold" Foreground="#15314D" Margin="0,0,0,8"/><TextBox x:Name="LogText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0"/></DockPanel></Border>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="#E7EEF6" Padding="18,5"><TextBlock x:Name="StatusBar" Text="准备就绪 · 扫描查询 DNS/mDNS 名称；认证后读取设备状态与 MAC。" FontSize="12" Foreground="#48627B"/></Border>
 </Grid>
</Window>
